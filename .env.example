# Vercel 프로젝트의 Environment Variables에 백엔드 공개 주소를 설정하세요.
# 예: https://api.example.com
VITE_API_BASE_URL=https://api.solusi.co.kr/api/v1
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-3077425787731419
# Responsive display ad unit ID.
VITE_GOOGLE_ADSENSE_SLOT=1905550513
# 임시로 포텔리어 배너만 표시. true로 변경하면 기존 쿠팡/AdSense 혼합 복원.
VITE_ENABLE_EXTERNAL_ADS=false
VITE_GA_MEASUREMENT_ID=G-4688VX043W

# 기업별 배너 목적지. 비워두면 오늘의 야구 링크에 기업별 UTM을 붙입니다.
VITE_CHEONSINDANG_KIA_URL=
VITE_CHEONSINDANG_SAMSUNG_URL=
VITE_CHEONSINDANG_LOTTE_URL=
VITE_CHEONSINDANG_LG_URL=
VITE_CHEONSINDANG_DOOSAN_URL=
VITE_CHEONSINDANG_HANWHA_URL=
VITE_CHEONSINDANG_KT_URL=
VITE_CHEONSINDANG_NC_URL=

# 오늘의 야구 광고 링크 (from=guessPlayer 유지)
VITE_BASEBALL_FORTUNE_URL=https://www.fortelior.com/ko/baseball?from=guessPlayer
